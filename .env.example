# Supabase Credentials (Get these from Project Settings -> API)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Configure the matching Turnstile secret in Supabase Auth's CAPTCHA settings.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Cloudflare Workers preset for TanStack Start (used during deployment building)
NITRO_PRESET=cloudflare
